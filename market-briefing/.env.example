# ── SMTP Credentials ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Your SMTP server (e.g. smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# 465 for SSL, 587 for STARTTLS
SMTP_PORT=587

# Set to "true" only when using port 465 (SSL)
SMTP_SECURE=false

# Your login username (usually your email address)
SMTP_USER=your-email@gmail.com

# Your password or app-specific password
# Gmail: generate one at https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password
